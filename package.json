{
  "name": "openpood",
  "private": true,
  "version": "1.0.3",
  "description": "Voice dictation for Windows, macOS, and Linux: hold a hotkey, speak, and the text is pasted at your cursor.",
  "author": {
    "name": "Gotzastory",
    "email": "gotzastory@users.noreply.github.com"
  },
  "desktopName": "com.openpood.app.desktop",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.47",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.1",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.3.0",
    "electron-store": "^11.0.2",
    "electron-updater": "6.8.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.openpood.app",
    "productName": "OpenPood",
    "publish": {
      "provider": "github",
      "owner": "gotzastory",
      "repo": "OpenPood",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/brand/openpood.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "guid": "3d3b2486-1b4f-5e19-895e-ab7f29245ba3"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OpenPood needs microphone access to dictate speech into text."
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "executableName": "openpood",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "Voice dictation for the desktop",
      "description": "Press a global hotkey, speak, and OpenPood pastes the transcript at your cursor.",
      "desktop": {
        "entry": {
          "Name": "OpenPood",
          "Comment": "Voice dictation — press a hotkey, speak, paste at your cursor",
          "Categories": "Utility;AudioVideo;",
          "StartupWMClass": "com.openpood.app"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "x11-utils"
      ]
    }
  },
  "overrides": {
    "fast-uri": "3.1.9"
  }
}
