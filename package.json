{
  "name": "openpood",
  "private": true,
  "version": "1.0.1",
  "description": "Voice dictation for Windows: hold a hotkey, speak, and the text is pasted at your cursor.",
  "author": "Gotzastory",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.47",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.3.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.openpood.app",
    "productName": "OpenPood",
    "publish": {
      "provider": "github",
      "owner": "gotzastory",
      "repo": "OpenPud",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/brand/openpood.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "guid": "3d3b2486-1b4f-5e19-895e-ab7f29245ba3"
    }
  }
}
